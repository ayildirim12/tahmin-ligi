rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---- Read-only reference / worker-owned data ----
    // The GitHub Actions worker writes these via the Admin SDK, which bypasses
    // rules entirely — so `write: if false` here just means "no client may
    // ever write this," not "nothing can."

    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /standings/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /meta/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /syncState/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---- Users ----
    // A user's own profile doc. Never readable by anyone else (protects email).

    match /users/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;
      allow create: if isSelf(uid);
      allow update: if isSelf(uid);
      allow delete: if isSelf(uid);
    }

    // ---- Invite codes ----
    // Deliberately `get`-only, never `list` — a code can be resolved if you
    // already know it (from a shared link), but the set of all codes can
    // never be enumerated/browsed.

    match /inviteCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)).data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.ownerUid == request.auth.uid
        && request.resource.data.communityId == resource.data.communityId
        && request.resource.data.createdByUid == resource.data.createdByUid;
      allow delete: if isSignedIn()
        && get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.ownerUid == request.auth.uid;
    }

    // ---- Collection-group access ----
    // Firestore only applies a `collectionGroup()` query's security to rules
    // written with the `{path=**}/<collectionId>/{docId}` wildcard form — the
    // ordinary nested rules below (under `communities/{communityId}/...`)
    // govern direct, single-community-scoped reads/writes only. Both of these
    // are deliberately self-uid-only: they exist purely to let a signed-in
    // user discover their OWN membership/prediction docs scattered across
    // every community, never anyone else's.

    // `get` on a document that doesn't exist yet gives a null `resource` —
    // dereferencing `resource.data` on it is a rules evaluation ERROR (which
    // denies the request), not a clean `false`. Since a client legitimately
    // `getDoc()`s/listens to paths that may not have been written yet (e.g.
    // "do I have a prediction for this match"), `resource == null` must be
    // allowed through here — there's nothing to leak from a doc that isn't
    // there, and the SDK correctly reports it as not-existing either way.
    match /{path=**}/members/{memberUid} {
      allow get: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /{path=**}/predictions/{predictionId} {
      allow get: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- Communities ----

    match /communities/{communityId} {
      function isMember() {
        return isSignedIn()
          && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
      }

      // `list` is never allowed on this collection — a client only ever
      // `get()`s a community whose ID it already knows (from the user's
      // communityIds cache, or the members collection-group query). This
      // removes any "browse all communities" surface entirely.
      allow get: if isMember();
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;

      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;

      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      // ---- Members ----

      match /members/{memberUid} {
        function callerIsMember() {
          return isSignedIn()
            && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
        }
        function communityOwnerUid() {
          return get(/databases/$(database)/documents/communities/$(communityId)).data.ownerUid;
        }

        // Roster access, scoped to a single, already-known community (e.g.
        // `onSnapshot(collection(db,'communities',id,'members'))`). Reading
        // your OWN member doc across every community — which powers the
        // collection-group "which communities am I in" discovery query in
        // useCommunities.ts — is handled by the separate `{path=**}` rule
        // block below: a rule nested under a specific parent path like this
        // one does NOT govern `collectionGroup()` queries in Firestore; only
        // an explicit `{path=**}/members/{id}` block does.
        allow get: if callerIsMember();
        allow list: if callerIsMember();

        // Two distinct creation paths:
        //  - the community owner's own doc, created right after the community
        //    itself (sequential writes — see src/firebase/communityActions.ts —
        //    so this `get()` sees an already-committed community doc);
        //  - anyone else joining via a valid, active invite code, which the
        //    client must attach as `joinedViaCode` on the doc being created so
        //    the rule can verify it via `get()`.
        allow create: if isSignedIn()
          && request.auth.uid == memberUid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.totalPoints == 0
          && request.resource.data.totalPredictions == 0
          && request.resource.data.winsCount == 0
          && (
            (
              request.resource.data.role == 'owner'
              && communityOwnerUid() == request.auth.uid
            )
            || (
              request.resource.data.role == 'member'
              && request.resource.data.joinedViaCode is string
              && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.joinedViaCode)).data.communityId == communityId
              && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.joinedViaCode)).data.active == true
            )
          );

        // Only profile-display fields are self-editable. totalPoints /
        // totalPredictions / winsCount / role are worker-only (Admin SDK
        // bypasses rules — this collection simply never grants a client path
        // to touch them).
        allow update: if isSignedIn()
          && request.auth.uid == memberUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL']);

        // Anyone may delete their own member doc (leave); the owner may also
        // remove someone else's. The client additionally guards against an
        // owner casually leaving a multi-member community without first
        // transferring or deleting it — a UX safeguard, not a security
        // boundary, since orphaning owner-less admin rights isn't a data leak.
        allow delete: if isSignedIn()
          && (request.auth.uid == memberUid || communityOwnerUid() == request.auth.uid);
      }

      // ---- Predictions (community-scoped, per decision: a locked prediction
      // is visible only to members of the SAME community, never site-wide) ----

      match /predictions/{predictionId} {
        function callerIsMember() {
          return isSignedIn()
            && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
        }

        // `get` targets one specific doc, which may not exist yet (e.g. "do I
        // have a prediction for this match" before ever saving one) — a null
        // `resource` must be let through, since dereferencing `resource.data`
        // on it is a rules evaluation ERROR (denies the request), not `false`,
        // and there's nothing to leak from a document that isn't there.
        allow get: if callerIsMember()
          && (resource == null || resource.data.uid == request.auth.uid || resource.data.locked == true);

        // `list` requests only ever evaluate against documents that DO exist,
        // so no null-resource guard is needed here — but Firestore requires
        // every possible matching document to provably satisfy this condition,
        // meaning the client MUST issue queries filtered by
        // `where('uid','==', myUid)` or `where('locked','==', true)` (never an
        // unfiltered fetch of the whole subcollection). See
        // src/hooks/useGameweekPredictions.ts for the two-query pattern this
        // requires.
        allow list: if callerIsMember()
          && (resource.data.uid == request.auth.uid || resource.data.locked == true);

        allow create: if isSignedIn()
          && callerIsMember()
          && request.auth.uid == request.resource.data.uid
          && predictionId == (request.auth.uid + '_' + request.resource.data.matchId)
          && request.resource.data.homeGoals is int
          && request.resource.data.homeGoals >= 0 && request.resource.data.homeGoals <= 20
          && request.resource.data.awayGoals is int
          && request.resource.data.awayGoals >= 0 && request.resource.data.awayGoals <= 20
          && request.resource.data.locked == false
          && request.resource.data.points == null
          && request.time < get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.kickoffAt;

        allow update: if isSignedIn()
          && request.auth.uid == resource.data.uid
          && resource.data.locked == false
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.matchId == resource.data.matchId
          && request.resource.data.locked == resource.data.locked
          && request.resource.data.points == resource.data.points
          && request.resource.data.homeGoals is int
          && request.resource.data.homeGoals >= 0 && request.resource.data.homeGoals <= 20
          && request.resource.data.awayGoals is int
          && request.resource.data.awayGoals >= 0 && request.resource.data.awayGoals <= 20
          && request.time < get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.kickoffAt;

        // Self-delete, no time restriction — used by the account-deletion
        // cascade. A user removing their own prediction (even a finalized,
        // already-scored one) correctly makes it disappear from any
        // leaderboard, matching "right to be forgotten" expectations.
        // The community owner may also delete ANY prediction doc within
        // their own community — needed to clean up a removed/departed
        // member's predictions (which that member didn't delete themselves)
        // and when tearing down the whole community.
        allow delete: if isSignedIn()
          && (
            request.auth.uid == resource.data.uid
            || get(/databases/$(database)/documents/communities/$(communityId)).data.ownerUid == request.auth.uid
          );
      }
    }
  }
}
